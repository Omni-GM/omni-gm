{
  "name": "Omni-GM",
  "language": "typescript",
  "ignore": ["convex/_generated", "fixtures", "proof"],
  "test": "pnpm exec vitest run -t {filter}",
  "testMatch": "Tests(?:\\s|\\u001b\\[[0-9;]*m)+[1-9][0-9]* passed",
  "testJson": "pnpm exec vitest run -t {filter} --reporter=json --outputFile={out}",
  "wellKnown": [
    "Convex",
    "WorkOS",
    "AuthKit",
    "MCP",
    "Claude",
    "Claude Desktop",
    "ChatGPT",
    "Daggerheart",
    "D&D",
    "TTRPG"
  ]
}
