    "procedures": "tsx scripts/procedures.ts && biome format --write convex/skillFiles.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "convex": "1.46.0",
    "convex-mcp-gateway": "2.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@posthog/coherence": "^1.7.2",
    "@types/node": "26.6.5",
    "convex-test": "0.0.61",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "zod": "4.6.5"
  }
}
