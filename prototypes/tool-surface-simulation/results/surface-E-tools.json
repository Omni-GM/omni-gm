 {
  "name": "frame_update",
  "write": true,
  "description": "Change only the given fields of the current adventure frame, with the GM's reason. The frame is intent, never story state. Basis rule: a player_guess or player_plan only touches a thread or character_goal. Never draft prep.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "reason": {
     "type": "string"
    },
    "fields": {
     "type": "object",
     "properties": {
      "goal": {
       "type": "string"
      },
      "stakes": {
       "type": "string"
      },
      "timeframe": {
       "type": "string"
      },
      "pressure": {
       "type": "string"
      },
      "finale": {
       "type": "string"
      },
      "moves_main_plot": {
       "type": "string"
      },
      "pulls_in": {
       "type": "string"
      },
      "next_session_starts": {
       "type": "string"
      }
     },
     "additionalProperties": false,
     "description": "Only the frame fields to change; the rest stay as they are."
    }
   },
   "required": [
    "reason",
    "fields"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "schema_change",
  "write": true,
  "description": "Change the schema. Only when the GM explicitly asks.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "reason": {
     "type": "string"
    },
    "ops": {
     "minItems": 1,
     "type": "array",
     "items": {
      "oneOf": [
       {
        "type": "object",
        "properties": {
         "op": {
          "type": "string",
          "const": "add_property"
         },
         "kind": {
          "type": "string"
         },
         "key": {
          "type": "string"
         },
         "type": {
          "type": "string",
          "enum": [
           "text",
           "enum",
           "number"
          ]
         },
         "enumValues": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "description": {
          "type": "string"
         }
        },
        "required": [
         "op",
         "kind",
         "key",
         "type",
         "description"
        ],
        "additionalProperties": false
       },
       {
        "type": "object",
        "properties": {
         "op": {
          "type": "string",
          "const": "retire_property"
         },
         "kind": {
          "type": "string"
         },
         "key": {
          "type": "string"
         }
        },
        "required": [
         "op",
         "kind",
         "key"
        ],
        "additionalProperties": false
       },
       {
        "type": "object",
        "properties": {
         "op": {
          "type": "string",
          "const": "add_relationship_type"
         },
         "type": {
          "type": "string"
         },
         "label": {
          "type": "string"
         },
         "inverseLabel": {
          "type": "string"
         },
         "from": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "to": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "description": {
          "type": "string"
         }
        },
        "required": [
         "op",
         "type",
         "label",
         "inverseLabel",
         "from",
         "to",
         "description"
        ],
        "additionalProperties": false
       }
      ]
     }
    }
   },
   "required": [
    "reason",
    "ops"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "skill",
  "write": false,
  "description": "The procedures for Omni-GM work, each with the standing rules. Call without a name to list them; call with a name to load one. Load the matching procedure before you start a workflow (transcript upload and scenes, debrief, frame talk, prep, plank answers).",
  "inputSchema": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 }
]
