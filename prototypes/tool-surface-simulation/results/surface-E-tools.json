[
 {
  "name": "find",
  "write": false,
  "description": "Search the whole store: entities (names, aliases, properties), change sources, scene summaries, and transcripts. Returns ranked hits, each with a ref for get.\nWith no query it lists instead: all entities (optionally only some kinds) and scenes, with their refs. Use that to see what exists before a debrief.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "query": {
     "description": "Words to look for, e.g. 'Saltmere mine'. Omit to list.",
     "type": "string"
    },
    "types": {
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "entity",
       "source",
       "scene",
       "transcript"
      ]
     }
    },
    "kinds": {
     "description": "Limit entity hits to these kinds.",
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "limit": {
     "description": "Default 10 for a search, 100 for a list.",
     "type": "integer",
     "minimum": -9007199254740991,
     "maximum": 200
    }
   },
   "additionalProperties": false
  }
 },
 {
  "name": "get",
  "write": false,
  "description": "Read one or more things by ref (pass refs to read several at once):\noverview | schema | frame | entity:<id> (with history) | session:<id> | scene:<session>/<n> (with its transcript) | transcript:<session>[@<timestamp>] | debrief:<session> (the draft).",
  "inputSchema": {
   "type": "object",
   "properties": {
    "ref": {
     "type": "string"
    },
    "refs": {
     "maxItems": 25,
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  }
 },
 {
  "name": "session_create",
  "write": true,
  "description": "Record a played session in the current adventure.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "playedOn": {
     "type": "string",
     "description": "YYYY-MM-DD"
    }
   },
   "required": [
    "playedOn"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "transcript_upload_url",
  "write": true,
  "description": "Get where to upload a session's transcript file. The file goes from disk to the URL, never through a tool call.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session id like \"s3\", or its number."
    }
   },
   "required": [
    "session"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "scenes_set",
  "write": true,
  "description": "Store a session's scenes, replacing any earlier split.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session id like \"s3\", or its number."
    },
    "scenes": {
     "minItems": 1,
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "title": {
        "type": "string"
       },
       "start": {
        "type": "string",
        "description": "Timestamp like \"0:14:02\"."
       },
       "end": {
        "type": "string"
       },
       "place": {
        "type": "string"
       },
       "summary": {
        "type": "string",
        "description": "Plot points only, one or two lines."
       }
      },
      "required": [
       "title",
       "start",
       "place",
       "summary"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "session",
    "scenes"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "debrief_add",
  "write": true,
  "description": "Add changes to a session's debrief draft (opens it if needed). Each change has scene, change (new/update/relate/unrelate), basis, sources, and why. Invalid changes are rejected one by one with the reason; the others are kept. Basis rule: a player_guess or player_plan only touches a thread or character_goal. Never draft prep.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session id like \"s3\", or its number."
    },
    "changes": {
     "minItems": 1,
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "change": {
        "oneOf": [
         {
          "type": "object",
          "properties": {
           "op": {
            "type": "string",
            "const": "new"
           },
           "tempKey": {
            "description": "Lets later changes refer to it as $tempKey.",
            "type": "string"
           },
           "kind": {
            "type": "string"
           },
           "name": {
            "type": "string"
           },
           "aliases": {
            "type": "array",
            "items": {
             "type": "string"
            }
           },
           "properties": {
            "type": "object",
            "propertyNames": {
             "type": "string"
            },
            "additionalProperties": {
             "type": [
              "string",
              "number"
             ]
            },
            "description": "Property key -> value. Only keys the schema allows for the kind."
           }
          },
          "required": [
           "op",
           "kind",
           "name"
          ],
          "additionalProperties": false
         },
         {
          "type": "object",
          "properties": {
           "op": {
            "type": "string",
            "const": "update"
           },
           "entity": {
            "type": "string",
            "description": "An entity id (e.g. \"e12\"), or \"$tempKey\" for an entity created earlier in the same batch or draft."
           },
           "properties": {
            "type": "object",
            "propertyNames": {
             "type": "string"
            },
            "additionalProperties": {
             "type": [
              "string",
              "number"
             ]
            },
            "description": "Property key -> value. Only keys the schema allows for the kind."
           },
           "addAliases": {
            "type": "array",
            "items": {
             "type": "string"
            }
           }
          },
          "required": [
           "op",
           "entity"
          ],
          "additionalProperties": false
         },
         {
          "type": "object",
          "properties": {
           "op": {
            "type": "string",
            "const": "relate"
           },
           "type": {
            "type": "string"
           },
           "from": {
            "type": "string",
            "description": "An entity id (e.g. \"e12\"), or \"$tempKey\" for an entity created earlier in the same batch or draft."
           },
           "to": {
            "type": "string",
            "description": "An entity id (e.g. \"e12\"), or \"$tempKey\" for an entity created earlier in the same batch or draft."
           }
          },
          "required": [
           "op",
           "type",
           "from",
           "to"
          ],
          "additionalProperties": false
         },
         {
          "type": "object",
          "properties": {
           "op": {
            "type": "string",
            "const": "unrelate"
           },
           "type": {
            "type": "string"
           },
           "from": {
            "type": "string",
            "description": "An entity id (e.g. \"e12\"), or \"$tempKey\" for an entity created earlier in the same batch or draft."
           },
           "to": {
            "type": "string",
            "description": "An entity id (e.g. \"e12\"), or \"$tempKey\" for an entity created earlier in the same batch or draft."
           }
          },
          "required": [
           "op",
           "type",
           "from",
           "to"
          ],
          "additionalProperties": false
         }
        ]
       },
       "basis": {
        "minItems": 1,
        "type": "array",
        "items": {
         "type": "string",
         "enum": [
          "narrated",
          "npc_said",
          "rumor",
          "player_guess",
          "player_plan",
          "game_master"
         ]
        },
        "description": "Where the change comes from. A player_guess or player_plan may only touch a thread or character_goal."
       },
       "sources": {
        "minItems": 1,
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "quote": {
           "type": "string",
           "description": "Verbatim quote from the transcript, or the GM's own words."
          },
          "at": {
           "description": "Timestamp like \"0:14:02\".",
           "type": "string"
          }
         },
         "required": [
          "quote"
         ],
         "additionalProperties": false
        }
       },
       "why": {
        "type": "string",
        "description": "One short sentence: why this changes the story state."
       },
       "scene": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991,
        "description": "Scene ordinal in this session."
       }
      },
      "required": [
       "change",
       "basis",
       "sources",
       "why",
       "scene"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "session",
    "changes"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "debrief_drop",
  "write": true,
  "description": "Remove changes from a session's debrief draft by changeId.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session id like \"s3\", or its number."
    },
    "changeIds": {
     "minItems": 1,
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "session",
    "changeIds"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "debrief_commit",
  "write": true,
  "description": "Commit a session's debrief draft as one commit. Only after the GM says the draft is right.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session id like \"s3\", or its number."
    }
   },
   "required": [
    "session"
   ],
   "additionalProperties": false
  }
 },
